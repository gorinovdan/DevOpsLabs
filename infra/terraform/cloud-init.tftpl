#cloud-config
users:
  - default
  - name: ${ssh_user}
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
      - ${ssh_public_key}

ssh_pwauth: false
package_update: true
packages:
  - openssh-server

runcmd:
  - systemctl enable ssh || true
  - systemctl restart ssh || true
